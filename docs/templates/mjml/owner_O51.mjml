<mjml lang="en-AU">
  <mj-head>
    <mj-title>Helen, how's your home feeling?</mj-title>
    <mj-preview>It's been a week since your install. Tap a star to tell us how we went.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Helen, how's your home feeling?</mj-text>
          <mj-text>It's been a week since Sample Insulation Co installed your ceiling insulation. We'd love to know how we went.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="eyebrow center" padding="18px 12px 6px">Tap a star</mj-text>
          <mj-table align="center" width="250px" padding="0 12px 16px">
            <tr><td align="center" style="padding:0 3px;"><a href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=review&amp;stars=1" title="1 star" style="display:block;font-size:34px;line-height:44px;color:#F5A623;text-decoration:none;">&#9733;</a></td><td align="center" style="padding:0 3px;"><a href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=review&amp;stars=2" title="2 stars" style="display:block;font-size:34px;line-height:44px;color:#F5A623;text-decoration:none;">&#9733;</a></td><td align="center" style="padding:0 3px;"><a href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=review&amp;stars=3" title="3 stars" style="display:block;font-size:34px;line-height:44px;color:#F5A623;text-decoration:none;">&#9733;</a></td><td align="center" style="padding:0 3px;"><a href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=review&amp;stars=4" title="4 stars" style="display:block;font-size:34px;line-height:44px;color:#F5A623;text-decoration:none;">&#9733;</a></td><td align="center" style="padding:0 3px;"><a href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=review&amp;stars=5" title="5 stars" style="display:block;font-size:34px;line-height:44px;color:#F5A623;text-decoration:none;">&#9733;</a></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text padding="18px 12px 14px">Happy with everything? A quick Google review helps other Victorians find the rebate too.</mj-text>
          <mj-button href="https://g.page/r/TEST/review">Leave a Google review</mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 6px">Know someone with a cold house?</mj-text>
          <mj-text padding="0 18px 8px">Send them our free eligibility checker. It takes a minute, and they could get the rebate too.</mj-text>
          <mj-text padding="0 18px 16px"><a href="https://homeinsulationvictoria.com.au/homeowner?ref=TEST" style="color:#3C51C4;font-weight:700;">Send to a friend &#8594;</a></mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text mj-class="small" padding="14px 12px 0">Something not right? Contact Sample Insulation Co first on 0400 000 000, or reply to this email and we'll help.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
