<mjml lang="en-AU">
  <mj-head>
    <mj-title>It's your turn — confirm your free Ready Check</mj-title>
    <mj-preview>Press Confirm and one of our EEC-certified installers will be in touch.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen, it's your turn!</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Confirm your free Ready Check</mj-text>
          <mj-text>Press Confirm to tell us you'd still like your free Ready Check. One of our EEC-certified installers will then be in touch.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=turn">Confirm</mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 10px">What happens next</mj-text>
          <mj-table padding="0 18px 6px">
            <tr><td width="34" valign="top" style="padding:1px 0 14px;"><span class="num">1</span></td><td style="padding:0 0 14px;">Press <strong>Confirm</strong>.</td></tr>
            <tr><td width="34" valign="top" style="padding:1px 0 14px;"><span class="num">2</span></td><td style="padding:0 0 14px;">Within a day or so, your installer will text and email you 3 times for your free Ready Check.</td></tr>
            <tr><td width="34" valign="top" style="padding:1px 0 12px;"><span class="num">3</span></td><td style="padding:0 0 12px;">Tap the time that suits you (or suggest other days). They'll check your ceiling and measure up, and your fixed quote follows.</td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-owner.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
