<mjml lang="en-AU">
  <mj-head>
    <mj-title>Helen, your install is done. Here's your final invoice</mj-title>
    <mj-preview>Balance due today: $1,665.90 by bank transfer, reference HIV-TEST.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Helen, your install is done. Here's your final invoice</mj-text>
          <mj-text>Sample Insulation Co finished today. Your balance is due today, as agreed when you booked. Please pay by bank transfer using the details below, with your invoice number as the reference.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="eyebrow center" padding="18px 12px 6px">Balance due today</mj-text>
          <mj-text mj-class="big-blue" padding="0 12px 18px">$1,665.90</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 2px">Tax invoice HIV-TEST</mj-text>
          <mj-text mj-class="small" padding="0 18px 12px">11 November 2026</mj-text>
          <mj-text mj-class="small" padding="0 18px 10px">DC Construction Solutions Pty Ltd trading as Home Insulation Victoria · 1/33 Altree Court, Phillip ACT 2606 · ABN 44 671 613 979 · VEU Accredited Person A003654</mj-text>
          <mj-text font-size="14px" line-height="21px" padding="0 18px 12px"><strong>To:</strong> Helen Yang<br /><strong>Installation address:</strong> 824 High Street Road, Glen Waverley VIC 3150<br /><strong>Installed:</strong> Ceiling insulation — Bradford Gold Ceiling Batt R5.0 — 137.6 m² (ESC model 467911)</mj-text>
          <mj-table padding="0 18px 12px" font-size="14px" line-height="20px">
            <tr><td valign="top" style="padding:9px 0;">Bradford Gold R5.0 ceiling batts, 137.6 m² supplied and installed</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;">$2,752.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;">Old insulation removed and taken away, 40 m²</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;">$600.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;">Electrical safety check (PIESA)</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;">$349.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;">Accredited Person fee</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;">$349.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;"><strong>Total incl. GST</strong> <span class="muted">(GST $368.18)</span></td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;"><strong>$4,050.00</strong></td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;color:#057D40;">VEEC incentive (your VEU rebate, price reduction)</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;color:#057D40;">&#8722;$1,850.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;"><strong>Amount after VEEC incentive</strong></td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;"><strong>$2,200.00</strong></td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;">Paid: safety check (24 Oct)</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;">&#8722;$349.00</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:1px solid #E4E9F5;">Paid: deposit (4 Nov)</td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:1px solid #E4E9F5;">&#8722;$185.10</td></tr>
            <tr><td valign="top" style="padding:9px 0;border-top:2px solid #22376B;"><strong>Balance due today</strong></td><td align="right" valign="top" style="padding:9px 0 9px 12px;white-space:nowrap;border-top:2px solid #22376B;"><strong>$1,665.90</strong></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="h2" padding="18px 18px 8px">Pay by bank transfer</mj-text>
          <mj-table padding="0 18px 14px">
            <tr><td style="padding:8px 0;color:#5A6785;">Account name</td><td align="right" style="padding:8px 0 8px 12px;"><strong>Home Insulation Victoria</strong></td></tr>
            <tr><td style="padding:8px 0;border-top:1px solid #E4E9F5; color:#5A6785;">BSB</td><td align="right" style="padding:8px 0 8px 12px;border-top:1px solid #E4E9F5; white-space:nowrap;"><strong>082-902</strong></td></tr>
            <tr><td style="padding:8px 0;border-top:1px solid #E4E9F5; color:#5A6785;">Account</td><td align="right" style="padding:8px 0 8px 12px;border-top:1px solid #E4E9F5; white-space:nowrap;"><strong>777966349</strong></td></tr>
            <tr><td style="padding:8px 0;border-top:1px solid #E4E9F5; color:#5A6785;">Reference</td><td align="right" style="padding:8px 0 8px 12px;border-top:1px solid #E4E9F5; white-space:nowrap;"><strong>HIV-TEST</strong></td></tr>
            <tr><td style="padding:8px 0;border-top:1px solid #E4E9F5; color:#5A6785;">Amount</td><td align="right" style="padding:8px 0 8px 12px;border-top:1px solid #E4E9F5; white-space:nowrap;"><strong>$1,665.90</strong></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text padding="16px 12px 14px">Once it's paid, we'll send your completion pack: certificate, warranties and all your signed forms. You'll also get a short text asking you to sign your rebate form, if you haven't already.</mj-text>
          <mj-text mj-class="small" padding="0 12px">Something not right? Contact Sample Insulation Co first on 0400 000 000, or reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
