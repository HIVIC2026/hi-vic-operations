<mjml lang="en-AU">
  <mj-head>
    <mj-title>Re: Payment</mj-title>
    <mj-preview>The amount and the ways to pay are on your page.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">How to pay</mj-text>
          <mj-text>Everything you need is on your page, including the amount and the ways to pay.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST">See what's due and how to pay</mj-button>
          <mj-text padding="0 12px 6px">Cheers,<br />the Home Insulation Victoria team</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
