<mjml lang="en-AU">
  <mj-head>
    <mj-title>We've got your application</mj-title>
    <mj-preview>Here's what happens next, and how long it usually takes.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Thanks Sam,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">We've got your application</mj-text>
          <mj-text>Sample Insulation Co's application to install under the VEU program with Home Insulation Victoria is in.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 10px">What happens next</mj-text>
          <mj-table padding="0 18px 6px">
            <tr><td width="32" valign="top" style="padding:2px 0 14px;"><span class="num">1</span></td><td style="padding:0 0 14px;"><strong>We check your details</strong><br /><span class="muted">CII certification, public liability insurance (min $5 million) and PIISA training. Usually within 2 business days.</span></td></tr>
            <tr><td width="32" valign="top" style="padding:2px 0 14px;"><span class="num">2</span></td><td style="padding:0 0 14px;"><strong>You're approved</strong><br /><span class="muted">You get an email to set your password, plus an invite to Mitti, the app you'll fill forms in.</span></td></tr>
            <tr><td width="32" valign="top" style="padding:2px 0 12px;"><span class="num">3</span></td><td style="padding:0 0 12px;"><strong>Start adding jobs</strong><br /><span class="muted">Add your own customers in about 30 seconds, and take the jobs we send you.</span></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text padding="14px 12px 14px">If anything's missing, we'll email you exactly what we need.</mj-text>
          <mj-text mj-class="small">Questions? Just reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
