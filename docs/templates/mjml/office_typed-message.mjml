<mjml lang="en-AU">
  <mj-head>
    <mj-title>About your application</mj-title>
    <mj-preview>A message from the Home Insulation Victoria office.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Sam,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">About your application</mj-text>
          <mj-text>[The office's typed message appears here]</mj-text>
          <mj-text mj-class="small">Just reply to this email if you have any questions.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
