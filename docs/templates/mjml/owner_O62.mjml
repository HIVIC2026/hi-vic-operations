<mjml lang="en-AU">
  <mj-head>
    <mj-title>Here's your signed rebate form, Helen</mj-title>
    <mj-preview>Signed on 21 November 2026. Keep it with your home records.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Here's your signed rebate form, Helen</mj-text>
          <mj-text>Thanks for signing. Your copy of the rebate form for HV-TEST is attached. Keep it with your home records.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="center" padding="16px 12px 16px"><strong>Signed on 21 November 2026</strong></mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=done" padding="18px 12px 18px">See my job</mj-button>
          <mj-text mj-class="small" padding="0 12px">Questions about the rebate scheme? The Essential Services Commission is at veu@esc.vic.gov.au.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-owner.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
