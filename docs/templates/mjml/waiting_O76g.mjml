<mjml lang="en-AU">
  <mj-head>
    <mj-title>Re: Where is my quote?</mj-title>
    <mj-preview>You can read it and accept it on your page.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your quote is ready</mj-text>
          <mj-text>You can read it and accept it on your page.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=quote">See your quote</mj-button>
          <mj-text padding="0 12px 6px">Cheers,<br />the Home Insulation Victoria team</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
