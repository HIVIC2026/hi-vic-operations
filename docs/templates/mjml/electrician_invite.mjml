<mjml lang="en-AU">
  <mj-head>
    <mj-title>Sample Insulation Co has invited you to Home Insulation Victoria</mj-title>
    <mj-preview>Fill in the electrician application. Once you're approved, their jobs come straight to you.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Sam,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Sample Insulation Co has invited you</mj-text>
          <mj-text>Sample Insulation Co would like you to do the PIESAs on their Home Insulation Victoria jobs.</mj-text>
          <mj-text>To get started, fill in the electrician application. Once you're approved, their jobs come straight to you.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/electrician-onboarding?invite=TEST">Fill in the application</mj-button>
          <mj-text mj-class="small">Just reply to this email if you have any questions.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
