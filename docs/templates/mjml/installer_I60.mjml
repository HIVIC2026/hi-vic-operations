<mjml lang="en-AU">
  <mj-head>
    <mj-title>One quick step: the ESC privacy notice</mj-title>
    <mj-preview>It takes a minute and you don't need to sign in.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">One quick step, Sam</mj-text>
          <mj-text>Before we can register you as a VEU installer, the Essential Services Commission requires us to give you their privacy notice.</mj-text>
          <mj-text>Read it and tick. It takes a minute and you don't need to sign in.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/notice/TEST">Read and tick the notice</mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column mj-class="panel-amber">
          <mj-text padding="18px 18px 18px">Until it's done, you can't be put on a job for Sample Insulation Co.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
