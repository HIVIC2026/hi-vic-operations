<mjml lang="en-AU">
  <mj-head>
    <mj-title>Helen, we're not in Mildura 3500 just yet</mj-title>
    <mj-preview>We'll keep your details and email you when an installer covers your area.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Helen, we're not in Mildura just yet</mj-text>
          <mj-text>Thanks for your enquiry. Your home looks like it could qualify for the VEU ceiling insulation rebate. But we don't yet have a certified installer and licensed electrician with verified coverage for Mildura 3500. We only send people we've checked, so we won't rush it.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 10px">What happens now</mj-text>
          <mj-table padding="0 18px 6px">
            <tr><td width="34" valign="top" style="padding:2px 0 14px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 14px;">We keep your details on file. You don't need to do anything.</td></tr>
            <tr><td width="34" valign="top" style="padding:2px 0 14px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 14px;">We're adding installers across Victoria. When one covers your area, we'll email you.</td></tr>
            <tr><td width="34" valign="top" style="padding:2px 0 12px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 12px;">No payment, no obligation.</td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 2px">Know someone thinking about insulation?</mj-text>
          <mj-text padding="0 18px 6px">They can check their own eligibility in about a minute.</mj-text>
          <mj-text padding="0 18px 16px"><a href="https://estimate.homeinsulationvictoria.com.au/" style="color:#3C51C4;font-weight:700;">Send to a friend &rarr;</a></mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
