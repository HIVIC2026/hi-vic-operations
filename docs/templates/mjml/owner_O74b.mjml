<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your install day is moving</mj-title>
    <mj-preview>Sorry, your installer can't make Wednesday 11 November. You don't need to do anything.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your install day is moving</mj-text>
          <mj-text>Sorry, your installer can't make your install day on Wednesday 11 November any more.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-red">
          <mj-text mj-class="eyebrow center" padding="18px 12px 6px">No longer going ahead</mj-text>
          <mj-text mj-class="center" font-weight="700" padding="0 12px 16px"><span class="strike">Wednesday 11 November, 7:30am</span></mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text padding="16px 12px 14px"><strong>You don't need to do anything.</strong> Your installer will offer you new install days soon, and we'll send you a link to choose one.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=book">See my job</mj-button>
          <mj-text mj-class="small" padding="0 12px">Questions? Just reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
