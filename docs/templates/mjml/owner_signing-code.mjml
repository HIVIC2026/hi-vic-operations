<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your signing code</mj-title>
    <mj-preview>Your Home Insulation Victoria signing code is 123456. It expires in 10 minutes.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Your signing code</mj-text>
          <mj-text>Here's your Home Insulation Victoria signing code.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="center" font-family="'Courier New', Courier, monospace" font-size="42px" line-height="50px" font-weight="700" letter-spacing="8px" color="#22376B" padding="22px 12px 6px">123456</mj-text>
          <mj-text mj-class="small center" padding="0 12px 18px">Expires in 10 minutes</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text mj-class="small" padding="16px 12px 0">If you didn't ask for this, you can ignore this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
