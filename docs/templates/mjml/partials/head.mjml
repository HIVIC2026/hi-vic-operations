<mj-font name="Figtree" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800&amp;display=swap" />
  <mj-font name="Outfit" href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&amp;display=swap" />
  <mj-breakpoint width="480px" />
  <mj-raw>
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <meta name="x-apple-disable-message-reformatting">
  </mj-raw>
  <mj-attributes>
    <mj-all font-family="Figtree, Arial, Helvetica, sans-serif" />
    <mj-body background-color="#F2F4FC" width="600px" />
    <mj-wrapper background-color="#FFFFFF" border-radius="24px" padding="26px 16px 22px" />
    <mj-section padding="0" />
    <mj-column padding="0" />
    <mj-text color="#22376B" font-size="16px" line-height="25px" padding="0 12px 14px" />
    <mj-button background-color="#057D40" color="#FFFFFF" font-size="17px" font-weight="700" line-height="22px" border-radius="14px" inner-padding="16px 20px" padding="6px 12px 18px" width="100%" />
    <mj-table color="#22376B" font-size="15px" line-height="22px" padding="0 12px 10px" cellpadding="0" cellspacing="0" />
    <mj-divider border-color="#E4E9F5" border-width="1px" padding="6px 12px 18px" />
    <mj-image padding="0" />

    <mj-class name="h1" font-family="Outfit, Figtree, Arial, Helvetica, sans-serif" font-size="27px" line-height="34px" font-weight="800" padding="18px 12px 10px" />
    <mj-class name="h2" font-family="Outfit, Figtree, Arial, Helvetica, sans-serif" font-size="19px" line-height="26px" font-weight="700" padding="10px 12px 6px" />
    <mj-class name="hi" font-size="17px" line-height="26px" font-weight="600" padding="18px 12px 0" />
    <mj-class name="lead" font-size="17px" line-height="26px" />
    <mj-class name="small" font-size="13px" line-height="20px" color="#5A6785" />
    <mj-class name="eyebrow" font-size="12px" line-height="16px" font-weight="700" letter-spacing="1.2px" text-transform="uppercase" padding="0 12px 6px" />
    <mj-class name="center" align="center" />

    <mj-class name="big-green" font-family="Outfit, Figtree, Arial, Helvetica, sans-serif" font-size="36px" line-height="42px" font-weight="800" color="#057D40" align="center" padding="0 12px 4px" />
    <mj-class name="big-blue" font-family="Outfit, Figtree, Arial, Helvetica, sans-serif" font-size="40px" line-height="46px" font-weight="800" color="#3C51C4" align="center" padding="0 12px 4px" />

    <mj-class name="panel" padding="6px 0" inner-background-color="#F2F4FC" inner-border-radius="18px" />
    <mj-class name="panel-mint" padding="6px 0" inner-background-color="#E9FBF1" inner-border="2px solid #07BF61" inner-border-radius="18px" />
    <mj-class name="panel-card" padding="6px 0" inner-background-color="#FFFFFF" inner-border="1px solid #E4E9F5" inner-border-radius="18px" />
    <mj-class name="panel-amber" padding="6px 0" inner-background-color="#FFF7EA" inner-border="1px solid #F3D9A8" inner-border-radius="18px" />
    <mj-class name="panel-red" padding="6px 0" inner-background-color="#FDECEA" inner-border="1px solid #F4C7C2" inner-border-radius="18px" />
    <mj-class name="pad-top" padding-top="18px" />

    <mj-class name="btn-ghost" background-color="#FFFFFF" color="#3C51C4" border="2px solid #3C51C4" />
  </mj-attributes>
  <mj-style inline="inline">
    a { color: #3C51C4; }
    .tick { display:inline-block; width:20px; height:20px; line-height:20px; border-radius:10px; background:#07BF61; color:#FFFFFF; font-size:12px; font-weight:700; text-align:center; }
    .plus { display:inline-block; width:20px; height:20px; line-height:20px; border-radius:10px; background:#FFF1DB; color:#8A5200; font-size:14px; font-weight:700; text-align:center; }
    .num { display:inline-block; width:22px; height:22px; line-height:22px; border-radius:11px; background:#22376B; color:#FFFFFF; font-size:12px; font-weight:700; text-align:center; }
    .muted { color:#5A6785; }
    .strike { text-decoration:line-through; }
  </mj-style>
  <mj-style>
    :root { color-scheme: light; supported-color-schemes: light; }
    @media only screen and (max-width:479px) {
      .card { border-radius: 0 !important; }
    }
  </mj-style>
  <mj-html-attributes>
    <mj-selector path=".email-heading div">
      <mj-html-attribute name="role">heading</mj-html-attribute>
      <mj-html-attribute name="aria-level">1</mj-html-attribute>
    </mj-selector>
    <mj-selector path=".email-sub div">
      <mj-html-attribute name="role">heading</mj-html-attribute>
      <mj-html-attribute name="aria-level">2</mj-html-attribute>
    </mj-selector>
  </mj-html-attributes>
