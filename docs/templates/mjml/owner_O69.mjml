<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your ceiling insulation job HV-TEST has been cancelled</mj-title>
    <mj-preview>Nothing further will happen on it. If this was a mistake, just reply.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">Job cancelled</mj-text>
          <mj-text padding="0 12px 10px">Hi Helen,</mj-text>
          <mj-text>We've cancelled your ceiling insulation job at 824 High Street Road, Glen Waverley VIC 3150, as discussed. Nothing further will happen on it and you won't hear from us again about it unless you get back in touch.</mj-text>
          <mj-text>If this was a mistake or you'd like to pick it up again later, reply to this email.</mj-text>
          <mj-text padding="0 12px 0">Home Insulation Victoria</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
