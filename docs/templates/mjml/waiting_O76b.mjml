<mjml lang="en-AU">
  <mj-head>
    <mj-title>Re: Questions</mj-title>
    <mj-preview>Thanks for answering. Your spot isn't saved until you press the button.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">One more tap to save your spot</mj-text>
          <mj-text>Thanks, we've got your answers. Now just press Save my spot.</mj-text>
          <mj-text>Thousands of Victorians have registered. Spots are released in the order they were saved. No payment, no obligation.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/estimate/TEST/video">Save my spot</mj-button>
          <mj-text padding="0 12px 6px">Cheers,<br />the Home Insulation Victoria team</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
