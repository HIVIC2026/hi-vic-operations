<mjml lang="en-AU">
  <mj-head>
    <mj-title>HV-TEST is cleared for install – offer 3 install days by 4 December 2026</mj-title>
    <mj-preview>Offer Helen three install days with arrival times from your job page.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="h1" css-class="email-heading">HV-TEST is cleared for install</mj-text>
          <mj-text>The electrical safety check is done. Offer Helen three install days with arrival times from your job page.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/field/TEST-JOB">Offer install days</mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column mj-class="panel-amber">
          <mj-text mj-class="h2" padding="18px 18px 6px">⏰ The 30-day clock</mj-text>
          <mj-text padding="0 18px 10px">The install must happen within 30 days of this safety check (by 4 December 2026). After 30 days the check expires and has to be done again, and a new check may be charged.</mj-text>
          <mj-text padding="0 18px 18px">So please offer install days as soon as you can.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
