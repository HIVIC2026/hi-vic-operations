<mjml lang="en-AU">
  <mj-head>
    <mj-title>Re: What happens next?</mj-title>
    <mj-preview>Your installer has offered some times. Pick the one that suits you.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
