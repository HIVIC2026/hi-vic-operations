<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your signed consent form</mj-title>
    <mj-preview>Your copy of the owner's consent form for 824 High Street Road, Glen Waverley. The PDF is attached.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your signed consent form</mj-text>
          <mj-text>Here's your copy of the owner's consent form you signed for the ceiling insulation at 824 High Street Road, Glen Waverley VIC 3150. The signed form is attached as a PDF, and it's also on your job page.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST">See my job</mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 4px">Your signed form</mj-text>
          <mj-text mj-class="eyebrow" padding="10px 18px 6px">Section 1: Information to be shared</mj-text>
          <mj-text font-weight="700" font-size="15px" padding="0 18px 4px">Owner details</mj-text>
          <mj-table padding="0 18px 10px" font-size="14px" line-height="20px">
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">First name</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Helen</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Last name</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Yang</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Installation address</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>824 High Street Road, Glen Waverley VIC 3150</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Phone number</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>0400 000 000</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Email address</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>helen@example.com</strong></td></tr>
          </mj-table>

          <mj-text mj-class="eyebrow" padding="10px 18px 6px">Section 2: Declaration by owner</mj-text>
          <mj-text font-size="14px" line-height="20px" padding="0 18px 8px">I declare that:</mj-text>
          <mj-table padding="0 18px 4px" font-size="14px" line-height="20px">
            <tr><td width="28" valign="top" style="padding:2px 0 10px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 10px;">I am the owner of the property listed above, or I am authorised to provide consent on behalf of the owner.</td></tr>
            <tr><td width="28" valign="top" style="padding:2px 0 10px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 10px;">the details listed above are complete and accurate.</td></tr>
            <tr><td width="28" valign="top" style="padding:2px 0 10px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 10px;">I consent to DC Construction Solutions Pty Ltd trading as Home Insulation Victoria (VEU Accredited Person A003654) sending the information set out in section 1 of this form to the Essential Services Commission (commission)</td></tr>
            <tr><td width="28" valign="top" style="padding:2px 0 10px;"><span class="tick">&#10003;</span></td><td style="padding:0 0 10px;">I consent to the commission sharing the information set out in section 1 of this form with the Victorian WorkCover Authority (WorkSafe) and/or Energy Safe Victoria (ESV)</td></tr>
          </mj-table>
          <mj-table padding="0 18px 10px" font-size="14px" line-height="20px">
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Owner signature</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Helen Yang</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Date</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>2026-10-24</strong></td></tr>
          </mj-table>

          <mj-text mj-class="eyebrow" padding="10px 18px 6px">Section 3 – Accredited person details and declaration</mj-text>
          <mj-text font-weight="700" font-size="15px" padding="0 18px 4px">Part A: Accredited person details</mj-text>
          <mj-table padding="0 18px 10px" font-size="14px" line-height="20px">
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Accredited person name</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>DC Construction Solutions Pty Ltd trading as Home Insulation Victoria (VEU Accredited Person A003654)</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">First name</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Sample</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Last name</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Representative</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Role</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Director</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Phone number</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>0400 222 333</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Email address</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>ap@example.com</strong></td></tr>
          </mj-table>
          <mj-text font-weight="700" font-size="15px" padding="0 18px 4px">Part B: Declaration by accredited person</mj-text>
          <mj-text font-size="14px" line-height="20px" padding="0 18px 8px">I Sample Representative, am the authorised representative of DC Construction Solutions Pty Ltd trading as Home Insulation Victoria (VEU Accredited Person A003654) and declare that I have explained to the property owner the purpose for which this written consent is being obtained.</mj-text>
          <mj-table padding="0 18px 16px" font-size="14px" line-height="20px">
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Accredited person signature</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>Sample Representative</strong></td></tr>
            <tr><td style="padding:7px 0;border-top:1px solid #E4E9F5;color:#5A6785;width:40%;" valign="top">Date</td><td style="padding:7px 0 7px 12px;border-top:1px solid #E4E9F5;" valign="top"><strong>2026-10-24</strong></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text mj-class="small" padding="14px 12px 6px">Form ESC-Owners-Consent-Template-v1-20260414 · Record reference 000000000000</mj-text>
          <mj-text mj-class="small" padding="0 12px">Questions? Just reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
