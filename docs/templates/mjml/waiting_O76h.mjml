<mjml lang="en-AU">
  <mj-head>
    <mj-title>Re: Quote</mj-title>
    <mj-preview>Your Ready Check is done. We'll email you when your quote is ready.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your quote is being prepared</mj-text>
          <mj-text>Your Ready Check is done. We'll email you as soon as your quote is ready.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST">See where you're up to</mj-button>
          <mj-text padding="0 12px 6px">Cheers,<br />the Home Insulation Victoria team</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
