<mjml lang="en-AU">
  <mj-head>
    <mj-title>HV-TEST: please offer the owner 3 safety check times</mj-title>
    <mj-preview>You took this job a day ago and no times have been offered yet.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Sam,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Please offer the owner 3 safety check times</mj-text>
          <mj-text>You took the safety check job HV-TEST at 824 High Street Road, Glen Waverley a day ago, but no times have been offered to the owner yet.</mj-text>
          <mj-text>Please offer 3 times on 3 different days from your job page. The owner picks one and it's booked. It only takes a minute.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/field/TEST-JOB">Offer 3 times</mj-button>
          <mj-text mj-class="small">Can't do this job any more? Just reply to this email and we'll sort it out.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
