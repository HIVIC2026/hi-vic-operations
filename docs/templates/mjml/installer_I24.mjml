<mjml lang="en-AU">
  <mj-head>
    <mj-title>Owner declined – HV-TEST, 824 High Street Road, Glen Waverley</mj-title>
    <mj-preview>The job is closed. Nothing more for you to do.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Sam,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Helen has declined the quote</mj-text>
          <mj-text>Helen Yang declined the quote for 824 High Street Road, Glen Waverley (HV-TEST).</mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column mj-class="panel">
          <mj-text mj-class="eyebrow" padding="18px 18px 6px">Reason given</mj-text>
          <mj-text padding="0 18px 6px"><strong>Price too high</strong></mj-text>
          <mj-text padding="0 18px 18px" font-style="italic">"We've decided to wait until next year."</mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text padding="14px 12px 14px">Nothing more to do. The job is closed. If Helen changes their mind, we can reopen it from our side. Just let us know.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/field/TEST-JOB">See the job</mj-button>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
