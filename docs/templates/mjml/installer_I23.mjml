<mjml lang="en-AU">
  <mj-head>
    <mj-title>Owner accepted – HV-TEST, 824 High Street Road, Glen Waverley</mj-title>
    <mj-preview>Book the PIESA now.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />
      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Good news, Sam.</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Helen accepted!</mj-text>
          <mj-text>Helen Yang has accepted the quote for 824 High Street Road, Glen Waverley (HV-TEST) and has paid the $349 for the PIESA.</mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column mj-class="panel-card">
          <mj-text mj-class="h2" padding="18px 18px 10px">What happens next</mj-text>
          <mj-table padding="0 18px 6px">
            <tr><td width="32" valign="top" style="padding:2px 0 14px;"><span class="num">1</span></td><td style="padding:0 0 14px;"><strong>Book the PIESA</strong><br /><span class="muted">Pick your electrician on the job, call Helen, then add the day and time in the portal within 2 business days.</span></td></tr>
            <tr><td width="32" valign="top" style="padding:2px 0 14px;"><span class="num">2</span></td><td style="padding:0 0 14px;"><strong>Electrical upgrades, if needed</strong><br /><span class="muted">Quote, book and invoice them with Helen directly. Upload the Part C and Certificate of Electrical Safety before the install.</span></td></tr>
            <tr><td width="32" valign="top" style="padding:2px 0 12px;"><span class="num">3</span></td><td style="padding:0 0 12px;"><strong>Book the install</strong><br /><span class="muted">Call Helen and add the install day and Lead Installer in the portal. Helen pays her deposit to lock it in. Install within 30 days of the PIESA.</span></td></tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text padding="8px 0 0"></mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/field/TEST-JOB">Open the job</mj-button>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
