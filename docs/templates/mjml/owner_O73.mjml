<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your insulation warranty</mj-title>
    <mj-preview>The manufacturer's warranty for your Bradford Gold insulation is attached.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your insulation warranty</mj-text>
          <mj-text>Attached is the manufacturer's warranty for the Bradford Gold insulation we installed in your ceiling.</mj-text>
          <mj-text>We couldn't include it with your earlier email, so please keep this copy with your other job papers.</mj-text>
          <mj-text mj-class="small" padding="4px 12px 0">Any questions? Just reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
