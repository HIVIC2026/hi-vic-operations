<mjml lang="en-AU">
  <mj-head>
    <mj-title>Your electrical safety check needs a new time</mj-title>
    <mj-preview>Sorry, the electrician can't make Thursday 5 November. Please choose new times.</mj-preview>
    <mj-include path="./partials/head.mjml" />
  </mj-head>
  <mj-body>
    <mj-wrapper css-class="card">
      <mj-include path="./partials/header.mjml" />

      <mj-section>
        <mj-column>
          <mj-text mj-class="hi">Hi Helen,</mj-text>
          <mj-text mj-class="h1" css-class="email-heading" padding="4px 12px 10px">Your electrical safety check needs a new time</mj-text>
          <mj-text>Sorry, the electrician can't make your electrical safety check on Thursday 5 November any more.</mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column mj-class="panel-red">
          <mj-text mj-class="eyebrow center" padding="18px 12px 6px">No longer going ahead</mj-text>
          <mj-text mj-class="center" font-weight="700" padding="0 12px 16px"><span class="strike">Thursday 5 November, 8am</span></mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text padding="16px 12px 14px">Please choose some new times on your job page. It only takes a minute.</mj-text>
          <mj-button href="https://estimate.homeinsulationvictoria.com.au/my-job/TEST?screen=book">Choose new times</mj-button>
          <mj-text mj-class="small" padding="0 12px">Questions? Just reply to this email.</mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./partials/footer-trade.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
