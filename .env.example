# Safe local example environment for Home Insulation Victoria.
# Copy to `.env` and fill with YOUR OWN local/dev values. Never commit a real `.env`.
#
# ──────────────────────────────────────────────────────────────────────────
# PUBLIC / PUBLISHABLE (safe to expose to the browser; still RLS-gated)
# These are build-time inlined by Vite (VITE_ prefix) and/or read server-side.
# ──────────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_ID=your-local-project-ref
SUPABASE_URL=https://your-local-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

VITE_SUPABASE_PROJECT_ID=your-local-project-ref
VITE_SUPABASE_URL=https://your-local-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ──────────────────────────────────────────────────────────────────────────
# SECRETS — SERVER-SIDE ONLY. DO NOT put these in any committed file.
# The app reads these from the process environment (process.env) and FAILS
# CLOSED if missing. Provide them via your shell, a local untracked `.env`,
# or your secret manager / Lovable Cloud connection. NEVER prefix with VITE_.
# ──────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=         # privileged; bypasses RLS — keep secret
# LOVABLE_CRON_SECRET=               # cron authentication secret
# LOVABLE_CRON_SECRET_PREVIOUS=      # rotation overlap secret (optional)
